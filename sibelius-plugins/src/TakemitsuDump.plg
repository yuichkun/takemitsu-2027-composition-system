{
	Initialize "() {
		AddToPluginsMenu(_MenuName, 'Run');
	}"

	_MenuName "Takemitsu: Dump Score Objects"

	Run "() {
		if (Sibelius.ScoreCount = 0) {
			Sibelius.MessageBox('No score is open.');
			return False;
		}
		SetInterpreterOption(SupportHalfSemitonePitchValues);
		score = Sibelius.ActiveScore;
		out = LogPath(score, '-dump.txt');
		text = '# takemitsu dump' & Chr(10);
		text = text & 'score: ' & score.FileName & Chr(10);
		text = text & 'sibelius: ' & Sibelius.ProgramVersion & Chr(10);
		text = text & 'transposing score: ' & score.TransposingScore & Chr(10);
		count = 0;
		for each Staff s in score {
			text = text & Chr(10) & '## staff ' & s.StaffNum & ' | ' & s.FullInstrumentName & Chr(10);
			for each Bar b in s {
				for each o in b {
					text = text & Describe(o, b) & Chr(10);
					count = count + 1;
				}
			}
		}
		Sibelius.CreateTextFile(out);
		Sibelius.AppendTextFile(out, text, True);
		Sibelius.MessageBox('Dumped ' & count & ' objects to ' & out);
		return True;
	}"

	LogPath "(score, suffix) {
		fn = score.FileName;
		if (Length(fn) = 0) {
			fn = Sibelius.GetDocumentsFolder() & '/untitled-score';
		}
		return fn & suffix;
	}"

	Describe "(o, b) {
		desc = 'bar ' & b.BarNumber & ' pos ' & o.Position & ' v' & o.VoiceNumber & ' ' & o.Type;
		t = o.Type;
		if (t = 'NoteRest') {
			return desc & ' ' & DescribeNoteRest(o);
		}
		if (t = 'Text') {
			return desc & ' style=' & o.StyleId & ' (' & o.StyleAsText & ') dy=' & o.Dy & ' text=' & Chr(34) & o.Text & Chr(34);
		}
		if (t = 'Line') {
			return desc & ' style=' & o.StyleId & ' (' & o.StyleAsText & ') dur=' & o.Duration & ' endbar=' & o.EndBarNumber & ' endpos=' & o.EndPosition;
		}
		if (t = 'SymbolItem') {
			return desc & ' name=' & Chr(34) & o.Name & Chr(34) & ' index=' & o.Index & ' dy=' & o.Dy;
		}
		if (t = 'InstrumentChange') {
			return desc & ' style=' & o.StyleId & ' fullname=' & Chr(34) & o.FullInstrumentName & Chr(34);
		}
		if (t = 'Clef') {
			return desc & ' style=' & o.StyleId;
		}
		return desc;
	}"

	DescribeNoteRest "(nr) {
		s = 'dur=' & nr.Duration;
		if (nr.GraceNote) {
			s = s & ' grace';
		}
		if (nr.NoteCount = 0) {
			return s & ' rest';
		}
		s = s & ' trem=' & nr.SingleTremolos & '/' & nr.DoubleTremolos;
		arts = '';
		for a = 0 to 16 {
			if (nr.GetArticulation(a)) {
				arts = arts & ArticName(a) & ',';
			}
		}
		if (Length(arts) > 0) {
			s = s & ' artic=' & arts;
		}
		for each Note n in nr {
			s = s & ' | ' & n.Name & ' pitch=' & n.Pitch & ' acc=' & n.Accidental & ' accVisible=' & n.IsAccidentalVisible & ' accStyle=' & n.AccidentalStyle & ' diat=' & n.DiatonicPitch & ' head=' & n.NoteStyle & ' tied=' & n.Tied;
		}
		return s;
	}"

	ArticName "(a) {
		if (a = 0) { return 'Custom1'; }
		if (a = 1) { return 'Staccato'; }
		if (a = 2) { return 'Staccatissimo'; }
		if (a = 3) { return 'Wedge'; }
		if (a = 4) { return 'Tenuto'; }
		if (a = 5) { return 'Accent'; }
		if (a = 6) { return 'Marcato'; }
		if (a = 7) { return 'Harmonic'; }
		if (a = 8) { return 'Plus'; }
		if (a = 9) { return 'UpBow'; }
		if (a = 10) { return 'DownBow'; }
		if (a = 11) { return 'Custom2'; }
		if (a = 12) { return 'SquarePause'; }
		if (a = 13) { return 'Pause'; }
		if (a = 14) { return 'TriPause'; }
		if (a = 15) { return 'Custom3'; }
		return 'Artic' & a;
	}"
}
